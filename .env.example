# --- Shield MVP (hackathon) ---
# URL del simulador oficial QualyData. Práctica: instancia local. Final: instancia asignada.
SIMULATOR_BASE_URL=http://localhost:8080
SHIELD_MODE=simulator

# Sesión del prototipo (cuentas judiciales ficticias)
JWT_SECRET=change-me-local-dev-only
SHIELD_ADMIN_DEMO_USER=jueza-laura-ficticia
SHIELD_ADMIN_DEMO_PASSWORD_HASH=

# Ruta al JSON con claves de firma DEMO de jueces (datos/juzgados.json del kit o copia local).
# SOLO servidor. Nunca en frontend, exports, videos ni commits públicos.
SHIELD_SIGNING_KEYS_PATH=./config/juzgados.demo.json

# --- Infraestructura ---
# Postgres/Neon reutiliza Drizzle existente. Si la demo local no puede conectar,
# usar el adaptador local (SQLite/JSONL) documentado en docs/arquitectura.md.
DATABASE_URL=
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- PeriodistApp base (NO requeridas en modo shield/simulator) ---
# Las integraciones IA/medios/billing quedan desconectadas en el MVP.
# DATABASE_URL de Neon original, claves AssemblyAI/Gemini/etc: no usar.
